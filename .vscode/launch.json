{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API Gateway",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/api-gateway",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ENV_FILE": "${workspaceFolder}/.env",
        "PYTHONPATH": "${workspaceFolder}/api-gateway"
      },
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--reload",
        "--log-level",
        "debug",
        "--port",
        "33330"
      ],
      "python": "${workspaceFolder}/api-gateway/.venv/bin/python3",
      "justMyCode": false,
      "preLaunchTask": "Poetry Install API Gateway"
    },
    {
      "name": "Debug Board service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/board-service",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ENV_FILE": "${workspaceFolder}/.env",
        "PYTHONPATH": "${workspaceFolder}/board-service"
      },
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--reload",
        "--log-level",
        "debug",
        "--port",
        "33333"
      ],
      "python": "${workspaceFolder}/board-service/.venv/bin/python3",
      "justMyCode": false,
      "preLaunchTask": "Poetry Install Board Service"
    },
    {
      "name": "Debug User service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/user-service",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ENV_FILE": "${workspaceFolder}/.env",
        "PYTHONPATH": "${workspaceFolder}/user-service"
      },
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--reload",
        "--log-level",
        "debug",
        "--port",
        "33334"
      ],
      "python": "${workspaceFolder}/user-service/.venv/bin/python3",
      "justMyCode": false,
      "preLaunchTask": "Poetry Install User Service"
    },
    {
      "name": "Debug Comment service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/comment-service",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ENV_FILE": "${workspaceFolder}/.env",
        "PYTHONPATH": "${workspaceFolder}/comment-service"
      },
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--reload",
        "--log-level",
        "debug",
        "--port",
        "33335"
      ],
      "python": "${workspaceFolder}/comment-service/.venv/bin/python3",
      "justMyCode": false,
      "preLaunchTask": "Poetry Install Comment Service"
    }
  ],
  "compounds": [
    {
      "name": "Start All Services",
      "configurations": [
        "Debug API Gateway",
        "Debug Board service",
        "Debug User service",
        "Debug Comment service"
      ],
      "stopAll": true
    }
  ]
}
