{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug API Gateway",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "program": "${workspaceFolder}/api-gateway/app/main.py",
        "console": "integratedTerminal",
        "env": {
          "ENV_FILE": "${workspaceFolder}/.env"
        },
        "args": ["--reload"]
      },
      {
        "name": "Debug Board App",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "program": "${workspaceFolder}/board-app/app/main.py",
        "console": "integratedTerminal",
        "env": {
          "ENV_FILE": "${workspaceFolder}/.env"
        },
        "args": ["--reload"]
      },
    ]
  }
  