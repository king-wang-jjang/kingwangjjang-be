# Ignore files generated by IDEs
.idea/
launch.json
# Ignore build output
build/
dist/

# Ignore dependency directories
node_modules/
vendor/

# Ignore log files
*.log

# Ignore environment configuration files
.env
.env.*
*.env
!.env.example

# Ignore compiled binaries
*.exe
*.dll
*.so
*.dylib

# Ignore package lock files
package-lock.json
yarn.lock

# Ignore database files
*.db
*.sqlite

# Ignore temporary files
*.tmp
*.swp
.dev-pids

# Ignore FastAPI specific files
__pycache__/
.pytest_cache/

log/

# Ignore Python __init__.py files
__init__.py

.venv/
.worktrees/
