# PostgreSQL
DOCKERHUB_USERNAME=your-dockerhub-username
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=kingwangjjang_dev
POSTGRES_USER=kingwangjjang
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://kingwangjjang:change-me@localhost:15432/kingwangjjang_dev
DOCKER_DATABASE_URL=postgresql+psycopg://kingwangjjang:change-me@kingwangjjang-postgres:5432/kingwangjjang_dev

# External server DB for ./dev.sh
# Set DEV_DATABASE_TARGET=auto to prefer the server DB when it is reachable.
# Use server to require the server DB, or local to always use the local dev DB.
DEV_DATABASE_TARGET=local
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Runtime
SERVER_RUN_MODE=FALSE
AUTH_COOKIE_SECURE=FALSE
WEBSITE_URL=http://localhost:8083/
CRAWLER_MEDIA_ROOT=CrawlScheduler/media
CRAWLER_MEDIA_HOST_ROOT=/mnt/kingwangjjang

# Auth
JWT_SECRET_KEY=change-me-access-secret
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret
# Comma-separated OAuth user IDs allowed to access administrator routes.
# Keep empty to deny administrator access to everyone.
ADMIN_USER_IDS=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
REDIRECT_URI=http://localhost:33330/callback

# Optional OAuth utilities
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI node router
AI_SERVICE_URL=http://localhost:33336
# Set both tokens to long random values in production.
AI_SERVICE_TOKEN=
AI_NODE_ADMIN_TOKEN=
AI_NODE_FAILURE_THRESHOLD=2
AI_NODE_RETRY_COOLDOWN_SECONDS=30
# Extra API-key environment variable names allowed in ai_nodes.api_key_env.
AI_NODE_API_KEY_ENV_ALLOWLIST=
# Used only to bootstrap ai_nodes when its table is empty. Later changes are
# managed through /gptservice/api/ai/nodes and persist in PostgreSQL.
CHATGPT_API_KEY=
OLLAMA_BASE_URL=http://100.104.51.52:11434
OLLAMA_BASE_URLS=http://100.104.51.52:11434,http://100.104.51.53:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=60
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_MODEL=qwen2.5-vl
VLLM_API_KEY=
VLLM_TIMEOUT_SECONDS=60
VLLM_IMAGE_PROMPT=이미지 안의 한국어 텍스트를 원문에 가깝게 추출해줘.

# Optional notifications
WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
MAIL_WEBHOOK_URL=

# Optional AWS monitor utilities
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
AWS_InstanceIds=
