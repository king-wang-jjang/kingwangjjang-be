# PostgreSQL
DOCKERHUB_USERNAME=your-dockerhub-username
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=kingwangjjang_dev
POSTGRES_USER=kingwangjjang
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://kingwangjjang:change-me@localhost:15432/kingwangjjang_dev
DOCKER_DATABASE_URL=postgresql+psycopg://kingwangjjang:change-me@kingwangjjang-postgres:5432/kingwangjjang_dev

# External server DB for ./dev.sh
# Set DEV_DATABASE_TARGET=auto to prefer the server DB when it is reachable.
# Use server to require the server DB, or local to always use the local dev DB.
DEV_DATABASE_TARGET=local
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Runtime
# Compose/server routing mode. dev.ps1 and dev.sh override this to FALSE.
SERVER_RUN_MODE=TRUE
# Keep FALSE only for local HTTP. Production HTTPS must use TRUE.
AUTH_COOKIE_SECURE=FALSE
WEBSITE_URL=http://localhost:8083/
CORS_ORIGINS=http://localhost:8083,http://localhost:8084,http://127.0.0.1:8083,http://127.0.0.1:8084
# Source mode: relative paths resolve from the workspace that contains both repos.
CRAWLER_MEDIA_ROOT=CrawlScheduler/media
CRAWLER_MEDIA_HOST_ROOT=/mnt/kingwangjjang

# Number of board summaries generated in parallel (1-16).
ANALYSIS_WORKER_CONCURRENCY=1
ANALYSIS_WORKER_IDLE_INTERVAL_SECONDS=3
ANALYSIS_WORKER_ACTIVE_INTERVAL_SECONDS=0.2
DISABLE_ANALYSIS_WORKER=FALSE
# Character-based, model-agnostic cap applied before board analysis inference.
AI_ANALYSIS_MAX_INPUT_CHARS=16000
# Reject title-only or sparse rows below this non-whitespace body length.
AI_ANALYSIS_MIN_BODY_CHARS=20
# Require a small Hangul/alphabetic signal so numeric-only rows are not summarized.
AI_ANALYSIS_MIN_LANGUAGE_CHARS=4
# For sparse image posts, enrich from local read-only media through gpt-service vision.
AI_ANALYSIS_VISION_FALLBACK_ENABLED=TRUE
AI_ANALYSIS_VISION_MAX_IMAGES=2
AI_ANALYSIS_VISION_MAX_IMAGE_BYTES=10000000
AI_ANALYSIS_VISION_MAX_PIXELS=40000000
AI_ANALYSIS_VISION_PROMPT=게시글 요약에 필요한 이미지의 장면과 맥락을 간결하게 설명하고, 보이는 한국어 텍스트는 원문에 가깝게 함께 추출해줘.
# Delay infrastructure-dependent retries such as a temporarily unavailable vision node.
AI_ANALYSIS_RETRYABLE_BACKOFF_SECONDS=300

# Auth
JWT_SECRET_KEY=change-me-access-secret
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret
# Comma-separated OAuth user IDs allowed to access administrator routes.
# Keep empty to deny administrator access to everyone.
ADMIN_USER_IDS=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Local source Gateway callback. Use :8000 for local Compose or the public HTTPS origin in production.
REDIRECT_URI=http://localhost:33330/callback

# Optional OAuth utilities
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI node router
AI_SERVICE_URL=http://localhost:33336
# Set both tokens to long random values in production.
AI_SERVICE_TOKEN=
AI_NODE_ADMIN_TOKEN=
AI_NODE_FAILURE_THRESHOLD=2
AI_NODE_RETRY_COOLDOWN_SECONDS=30
AI_REQUEST_DEADLINE_SECONDS=55
AI_DATABASE_STARTUP_ATTEMPTS=10
AI_DATABASE_STARTUP_DELAY_SECONDS=2
# Extra API-key environment variable names allowed in ai_nodes.api_key_env.
AI_NODE_API_KEY_ENV_ALLOWLIST=
# Used only to bootstrap ai_nodes when its table is empty. Later changes are
# managed through /gptservice/api/ai/nodes and persist in PostgreSQL.
AI_BOOTSTRAP_OLLAMA_ENABLED=TRUE
CHATGPT_API_KEY=
OLLAMA_BASE_URL=http://100.104.51.52:11434
OLLAMA_BASE_URLS=http://100.104.51.52:11434,http://100.104.51.53:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=60
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_MODEL=qwen2.5-vl
VLLM_API_KEY=
VLLM_TIMEOUT_SECONDS=60
VLLM_IMAGE_PROMPT=이미지 안의 한국어 텍스트를 원문에 가깝게 추출해줘.
# Dedicated OpenAI-compatible text summary node. For a source-mode gpt-service,
# use http://127.0.0.1:8000/v1 instead of host.docker.internal.
SUMMARY_VLLM_BASE_URL=http://host.docker.internal:8000/v1
SUMMARY_VLLM_MODEL=Qwen/Qwen3.6-27B
SUMMARY_VLLM_MAX_CONCURRENCY=2
SUMMARY_VLLM_TIMEOUT_SECONDS=50
# vLLM/Qwen summary controls. Disable these for upstreams that do not accept
# vLLM chat_template_kwargs.
OPENAI_COMPATIBLE_DISABLE_THINKING=TRUE
OPENAI_COMPATIBLE_MAX_TOKENS=512
OPENAI_COMPATIBLE_TEMPERATURE=0

# Optional notifications
WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
MAIL_WEBHOOK_URL=

# Optional AWS monitor utilities
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
AWS_InstanceIds=
